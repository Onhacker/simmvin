Options -Indexes
DirectoryIndex index.php

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /simp/

    # Generated documents and Composer dependencies are never public assets.
    # Keep this rule before the front-controller fall-through so an existing
    # file under either directory cannot bypass authentication.
    RewriteRule ^(?:output|vendor)(?:/|$) - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L,QSA]
</IfModule>

<FilesMatch "(^\.env|\.sql$|\.log$|\.md$|^README|composer\.(json|lock)$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<Files "service-worker.js">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </IfModule>
</Files>
