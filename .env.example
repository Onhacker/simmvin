# Use production on a server.  Set development only on a private local copy.
APP_ENV=production
APP_URL=http://localhost/simp/
APP_TIMEZONE=Asia/Makassar
APP_KEY=ganti-dengan-kunci-acak-yang-panjang

# The root values below are convenient for a private local install only.
# Use a dedicated least-privilege account and a non-empty secret in production.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=simp

# Koneksi ini terpisah dari DB_* dan boleh menunjuk host/server lain.
# Database ini khusus master lokasi MVIN, bukan database RAB.
# Gunakan akun baca-saja di produksi.
# Pada APP_ENV=production, HOST/PORT/USER/NAME wajib diisi eksplisit.
REGIONAL_DB_HOST=127.0.0.1
REGIONAL_DB_PORT=3306
REGIONAL_DB_USER=root
REGIONAL_DB_PASS=
REGIONAL_DB_NAME=simp_wilayah
